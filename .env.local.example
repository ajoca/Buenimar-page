# Configuración SMTP para envío de emails desde el formulario de contacto
# Copiar este archivo a .env.local y completar con las credenciales reales

SMTP_HOST=mail.buenimar.com
SMTP_PORT=465
SMTP_USER=pedidos@buenimar.com
SMTP_PASS=TU_CONTRASEÑA_AQUI
MAIL_TO=pedidos@buenimar.com
MAIL_FROM=Web Buenimar <no-reply@buenimar.com>

# Configuración del bot de chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CHAT_PROVIDER=auto
# CHAT_PROVIDER=local  -> fuerza modo gratis (sin OpenAI)

# Opcional: vector store para respuestas con archivos (FAQs, catálogos, etc.)
OPENAI_VECTOR_STORE_ID=
